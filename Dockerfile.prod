# Production image: compiled TanStack Start / Nitro server instead of the Vite dev server.
FROM node:22-alpine AS build
WORKDIR /app
ENV COREPACK_DEFAULT_TO_LATEST=0
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack pnpm@10.13.1 install --frozen-lockfile
COPY . .
# Client-side settings are inlined at build time, and .dockerignore keeps .env files out of the
# context, so pass them as build args (docker build --build-arg VITE_BASE_URL=...). Only non-empty
# values are written, so anything not passed falls back to the defaults in src/env/client.ts.
ARG VITE_BASE_URL
ARG VITE_MAX_FILE_SIZE_MB
ARG VITE_ENABLE_PASSKEYS
ARG VITE_ENABLE_2FA
ARG VITE_BILLING_PROVIDER
ARG VITE_BLOG_DATA_MODE
RUN for v in VITE_BASE_URL VITE_MAX_FILE_SIZE_MB VITE_ENABLE_PASSKEYS VITE_ENABLE_2FA VITE_BILLING_PROVIDER VITE_BLOG_DATA_MODE; do       eval "val=\${$v:-}"; [ -n "$val" ] && echo "$v=$val" >> .env.production; done;     cat .env.production 2>/dev/null | sed 's/=.*/=<set>/' || true
RUN corepack pnpm@10.13.1 build

FROM node:22-alpine
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
WORKDIR /app
COPY --from=build --chown=nodejs:nodejs /app/.output ./.output
USER nodejs
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
