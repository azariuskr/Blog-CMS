# Production image: compiled TanStack Start / Nitro server instead of the Vite dev server.
FROM node:22-alpine AS build
WORKDIR /app
ENV COREPACK_DEFAULT_TO_LATEST=0
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack pnpm@10.13.1 install --frozen-lockfile
COPY . .
RUN corepack pnpm@10.13.1 build

FROM node:22-alpine
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
WORKDIR /app
COPY --from=build --chown=nodejs:nodejs /app/.output ./.output
USER nodejs
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
